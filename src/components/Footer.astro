---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  showAbout?: boolean;
}
const { lang, showAbout = true } = Astro.props;
const a = ui[lang].about;
const f = ui[lang].footer;
const GITHUB_URL = 'https://github.com/MoveCall/onepage-reader';
const year = new Date().getFullYear();
---

{showAbout && (
  <section id="about" class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <p class="font-mono text-xs tracking-wider text-accent-600 uppercase">{a.eyebrow}</p>
      <h2 class="mt-3 max-w-[24ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink">{a.title}</h2>
      <div class="mt-5 space-y-4">
        {a.body.map((p) => <p class="max-w-[60ch] text-base/7 text-pretty text-ink/70">{p}</p>)}
      </div>
    </div>
  </section>
)}

<footer class="border-t border-ink/12 py-12">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-2.5">
        <Logo class="h-7 w-auto" />
        <span class="font-mono text-sm font-medium text-ink">{f.tagline}</span>
      </div>
      <p class="mt-3 max-w-[52ch] text-sm/6 text-ink/65">{f.openSource}</p>
      <p class="mt-1 text-sm/6 text-ink/65">{f.rights}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[13px]">
      <span id="vercount_container_site_pv" style="display:none" class="text-ink/55">
        {f.pvLabel} <span id="vercount_value_site_pv" class="font-medium text-ink/75">-</span>
      </span>
      <span id="vercount_container_site_uv" style="display:none" class="text-ink/55">
        <span class="mr-3 text-ink/25">·</span>{f.uvLabel} <span id="vercount_value_site_uv" class="font-medium text-ink/75">-</span>
        <span class="ml-3 text-ink/25">/</span>
      </span>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="font-medium text-ink/55 no-underline hover:text-ink">GitHub</a>
      <span class="text-ink/25">/</span>
      <span class="text-ink/55">© {year}</span>
    </div>
  </div>
</footer>
<script is:inline>
  (function () {
    var pvWrap = document.getElementById('vercount_container_site_pv');
    var uvWrap = document.getElementById('vercount_container_site_uv');
    var pvVal = document.getElementById('vercount_value_site_pv');
    var uvVal = document.getElementById('vercount_value_site_uv');
    if (!pvWrap || !uvWrap || !pvVal || !uvVal) return;

    var isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
    var targetUrl = isLocal
      ? 'https://movecall.github.io' + location.pathname
      : location.href;
    var uvKey = 'vercount_uv_movecall_github_io';
    var isNewUv = !isLocal && !localStorage.getItem(uvKey);
    if (isNewUv) {
      try { localStorage.setItem(uvKey, '1'); } catch (e) {}
    }

    fetch('https://events.vercount.one/api/v2/log', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url: targetUrl, isNewUv: isNewUv })
    })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (res) {
        var d = res && res.data;
        if (!d) return;
        pvVal.textContent = String(d.site_pv || 1);
        uvVal.textContent = String(Math.max(1, d.site_uv || 1));
        pvWrap.style.display = 'inline';
        uvWrap.style.display = 'inline';
      })
      .catch(function () {});
  })();
</script>
