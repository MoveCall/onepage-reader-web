---
import type { Lang } from '../i18n/ui';
import { ui, localizedPath } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  /** Override the language-switch target. 404 has no /zh counterpart, so it sends you home
      instead of linking a /zh/404/ that never renders (an infinite same-page loop). */
  switchHrefOverride?: string;
}
const { lang, switchHrefOverride } = Astro.props;
const t = ui[lang].nav;

const GITHUB_URL = 'https://github.com/MoveCall/onepage-reader';
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const otherLabel = lang === 'en' ? '中文' : 'EN';
const home = localizedPath('/', lang);
const fontsPath = localizedPath('/fonts', lang);
const txtToEpubPath = localizedPath('/txt-to-epub', lang);
const firmwarePath = localizedPath('/firmware', lang);
const logPath = localizedPath('/log', lang);

// Same page in the other language — strip the base prefix and locale, then rebuild.
const base = import.meta.env.BASE_URL;
let logical = Astro.url.pathname;
if (logical.startsWith(base)) logical = '/' + logical.slice(base.length);
logical = logical.replace(/^\/zh(?=\/|$)/, '') || '/';
const switchHref = switchHrefOverride ?? localizedPath(logical, otherLang);
---

<div id="nav-top" aria-hidden="true"></div>
<nav id="site-nav" class="sticky top-0 z-50 border-b border-ink/12 bg-paper/85 backdrop-blur">
  <div class="site-nav-inner mx-auto flex max-w-5xl items-center justify-between gap-3 px-6 py-3">
    <a href={home} class="flex shrink-0 items-center gap-2.5 no-underline" aria-label="OnePage">
      <Logo class="h-7 w-auto" />
      <span class="font-mono text-sm font-medium tracking-tight text-ink">OnePage<span class="hidden text-ink/55 sm:inline">&nbsp;· 壹頁</span></span>
    </a>

    <div class="flex items-center gap-x-1 font-mono text-[13px] sm:gap-x-3">
      <a href={`${home}#features`} class="hidden px-1.5 py-1 font-medium text-ink/55 no-underline hover:text-ink sm:inline">{t.features}</a>
      <a href={logPath} class="hidden px-1.5 py-1 font-medium text-ink/55 no-underline hover:text-ink sm:inline">{t.notes}</a>

      <div id="tools-dropdown" class="group relative">
        <button
          id="tools-menu-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          class="inline-flex cursor-pointer items-center gap-1 px-1.5 py-1 font-medium text-ink/55 hover:text-ink focus:outline-none"
        >
          <span>{t.tools}</span>
          <svg class="h-3.5 w-3.5 opacity-70 transition-transform duration-150 group-hover:rotate-180 group-[.open]:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 6.5L8 10.5L12 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div
          id="tools-menu"
          role="menu"
          aria-labelledby="tools-menu-btn"
          class="invisible absolute right-0 top-full z-50 pt-1.5 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-[.open]:visible group-[.open]:opacity-100 sm:left-0 sm:right-auto"
        >
          <div class="min-w-[9.5rem] rounded-md border border-ink/15 bg-surface py-1 shadow-sm">
            <a
              href={fontsPath}
              role="menuitem"
              class="block px-3 py-1.5 text-[13px] font-medium whitespace-nowrap text-ink/75 no-underline hover:bg-ink/5 hover:text-ink"
            >{t.fontTool}</a>
            <a
              href={txtToEpubPath}
              role="menuitem"
              class="block px-3 py-1.5 text-[13px] font-medium whitespace-nowrap text-ink/75 no-underline hover:bg-ink/5 hover:text-ink"
            >{t.txtToEpub}</a>
          </div>
        </div>
      </div>

      <a href={firmwarePath} class="px-1.5 py-1 font-medium text-ink/55 no-underline hover:text-ink">{t.firmware}</a>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hidden px-1.5 py-1 font-medium text-ink/55 no-underline hover:text-ink sm:inline">{t.github}</a>
      <a
        href={switchHref}
        class="ml-1 rounded-sm border border-ink/20 px-2 py-1 font-medium text-ink/65 no-underline hover:border-ink/40 hover:text-ink"
        aria-label="Switch language"
      >{otherLabel}</a>
    </div>
  </div>
</nav>

<script is:inline>
  // Shrink + solidify the sticky nav once the page scrolls past the top, and wire up the Tools dropdown.
  (function () {
    var nav = document.getElementById('site-nav');
    var sentinel = document.getElementById('nav-top');
    if (nav && sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        nav.classList.toggle('scrolled', !entries[0].isIntersecting);
      }).observe(sentinel);
    }

    var dropdown = document.getElementById('tools-dropdown');
    var btn = document.getElementById('tools-menu-btn');
    if (!dropdown || !btn) return;

    function setOpen(open) {
      dropdown.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(!dropdown.classList.contains('open'));
    });

    document.addEventListener('click', function (e) {
      if (!dropdown.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
