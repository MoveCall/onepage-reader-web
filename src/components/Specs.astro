---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui[lang].specs;
---

<section id="specs" class="scroll-mt-20 border-t border-ink/12 bg-surface py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.eyebrow}</p>
    <h2 class="mt-3 max-w-[24ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink" data-reveal style="--reveal-delay:80ms">{s.title}</h2>

    <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
      {s.groups.map((g, gi) => (
        <div class="grid gap-x-8 gap-y-2 py-5 sm:grid-cols-[8rem_1fr]" data-reveal style={`--reveal-delay:${gi * 55}ms`}>
          <p class="font-mono text-xs tracking-wider text-ink/45 uppercase sm:pt-0.5">{g.label}</p>
          <dl class="space-y-1.5">
            {g.rows.map((r) => (
              <div class="flex items-baseline justify-between gap-6">
                <dt class="shrink-0 text-sm text-ink/55">{r.k}</dt>
                <dd class="text-right font-mono text-sm text-ink/80">{r.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </div>
</section>
