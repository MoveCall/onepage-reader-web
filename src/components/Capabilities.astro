---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fe = ui[lang].features;
const cards = [fe.hardware, fe.webconfig, fe.controls];
---

<div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
  {cards.map((c, i) => (
    <div data-reveal style={`--reveal-delay:${i * 110}ms`}>
      <p class="font-mono text-xs tracking-wider text-ink/45 uppercase">{c.eyebrow}</p>
      <h3 class="mt-2 font-serif text-xl font-medium tracking-tight text-balance text-ink">{c.title}</h3>
      <p class="mt-3 text-sm/6 text-pretty text-ink/65">{c.body}</p>
      <ul role="list" class="mt-4 space-y-2 text-sm/6 text-ink/70">
        {c.points.map((p) => (
          <li class="flex gap-2.5">
            <span class="mt-2 size-1 shrink-0 rounded-full bg-accent-500"></span>
            {p}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
