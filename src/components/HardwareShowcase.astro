---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui[lang].showcase;

const BILIBILI_URL = 'https://www.bilibili.com/video/BV1BP846JE1W';

const HERO_SHOT_URL = 'https://image.lceda.cn/oshwhub/pullImage/2737bdad22464b8db6de064092417e70.jpg';
const OVERVIEW_SHOT_URL = 'https://image.lceda.cn/oshwhub/pullImage/ad00e354dc3449f4b63b15d07adae19f.png';

const galleryImages = [
  'https://image.lceda.cn/oshwhub/pullImage/4ad2608831e143539e7b00cd818a2472.jpg',
  'https://image.lceda.cn/oshwhub/pullImage/eb549f295c814874810c6bf7ee48bfc7.jpg',
  'https://image.lceda.cn/oshwhub/pullImage/228600d1054641eaa889581611c4ccab.jpg',
  'https://image.lceda.cn/oshwhub/pullImage/a89a162b81184b2f831e0994db476969.jpg',
  'https://image.lceda.cn/oshwhub/pullImage/beb5ddbcbf4245229a291c4392d0c528.jpg',
  'https://image.lceda.cn/oshwhub/pullImage/0f3fe1e023f84706b9722b3b2be851bc.jpg',
];
---

<!-- 1. ID Design & DXF Views -->
<section id="design" class="scroll-mt-20 border-t border-ink/12 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="mb-12 overflow-hidden rounded-2xl border border-ink/12 bg-surface shadow-sm sm:mb-16" data-reveal="art">
      <img
        src={HERO_SHOT_URL}
        alt="OnePage Hero Shot"
        referrerpolicy="no-referrer"
        loading="lazy"
        class="block h-auto w-full"
      />
    </div>

    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.design.eyebrow}</p>
        <h2 class="mt-3 max-w-[24ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl" data-reveal style="--reveal-delay:80ms">
          {s.design.title}
        </h2>
      </div>
      <a
        href={BILIBILI_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-ink/20 bg-surface px-4 py-2 font-mono text-xs font-medium text-ink/80 no-underline transition hover:border-ink/40 hover:text-ink"
        data-reveal
      >
        {s.design.videoLabel}
      </a>
    </div>
    <p class="mt-4 max-w-[64ch] text-base/7 text-pretty text-ink/65" data-reveal style="--reveal-delay:140ms">
      {s.design.lede}
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {s.design.pillars.map((p, i) => (
        <div
          class="rounded-xl border border-ink/12 bg-surface p-5"
          data-reveal
          style={`--reveal-delay:${180 + i * 70}ms`}
        >
          <p class="font-mono text-xs text-accent-600">{p.num} / {p.title}</p>
          <p class="mt-2 text-sm/6 text-ink/70">{p.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-[1.05fr_0.95fr]" data-reveal="art" style="--reveal-delay:220ms">
      <figure class="flex min-h-[360px] flex-col items-center justify-center rounded-2xl border border-ink/12 bg-[#9e9e9e] p-7">
        <img
          src="https://image.lceda.cn/oshwhub/pullImage/8c162f6a12e84c6894b404573aed483f.png"
          alt="OnePage Front DXF View"
          referrerpolicy="no-referrer"
          loading="lazy"
          class="h-auto w-48 max-w-full object-contain sm:w-56"
        />
        <figcaption class="mt-4 font-mono text-[11px] tracking-widest text-white/80 uppercase">
          {s.design.dxfCaptions.front}
        </figcaption>
      </figure>

      <div class="grid gap-5 sm:grid-rows-2">
        <figure class="flex min-h-[175px] flex-col items-center justify-center rounded-2xl border border-ink/12 bg-[#e4e6e7] p-6">
          <img
            src="https://image.lceda.cn/oshwhub/pullImage/85d20615f3fc419da9e31da894d69e72.png"
            alt="OnePage Right Edge View"
            referrerpolicy="no-referrer"
            loading="lazy"
            class="max-h-32 w-auto max-w-full object-contain"
          />
          <figcaption class="mt-3 font-mono text-[11px] tracking-widest text-ink/60 uppercase">
            {s.design.dxfCaptions.right}
          </figcaption>
        </figure>

        <figure class="flex min-h-[175px] flex-col items-center justify-center rounded-2xl border border-ink/12 bg-surface p-6">
          <img
            src="https://image.lceda.cn/oshwhub/pullImage/b1a16415219041969f7645b474e197a0.png"
            alt="OnePage USB Edge View"
            referrerpolicy="no-referrer"
            loading="lazy"
            class="max-h-28 w-auto max-w-[75%] object-contain"
          />
          <figcaption class="mt-3 font-mono text-[11px] tracking-widest text-ink/60 uppercase">
            {s.design.dxfCaptions.usb}
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- 2. Interfaces & Controls -->
<section id="interfaces" class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.interfaces.eyebrow}</p>
    <h2 class="mt-3 max-w-[24ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl" data-reveal style="--reveal-delay:80ms">
      {s.interfaces.title}
    </h2>
    <p class="mt-4 max-w-[60ch] text-base/7 text-pretty text-ink/65" data-reveal style="--reveal-delay:140ms">
      {s.interfaces.lede}
    </p>

    <div class="mt-10 grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div class="overflow-hidden rounded-2xl border border-ink/12 bg-paper p-5 sm:p-7" data-reveal="art">
        <img
          src="https://image.lceda.cn/oshwhub/pullImage/37f0c1f0406b40aebea2b65799d6cdc0.png"
          alt={s.interfaces.diagramAlt}
          referrerpolicy="no-referrer"
          loading="lazy"
          class="block h-auto w-full rounded-xl"
        />
      </div>

      <div class="grid gap-2.5">
        {s.interfaces.callouts.map((c, i) => (
          <div
            class="flex items-baseline gap-4 rounded-xl border border-ink/10 bg-paper/75 px-4 py-3"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <span class="font-mono text-xs font-semibold text-accent-600">{c.num}</span>
            <div>
              <div class="font-mono text-sm font-medium text-ink">{c.title}</div>
              <div class="mt-0.5 text-xs/5 text-ink/65">{c.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-ink/12 bg-paper p-6 sm:p-8" data-reveal>
      <div class="grid items-center gap-6 lg:grid-cols-[1fr_22rem]">
        <div>
          <p class="font-mono text-[11px] tracking-widest text-ink/50 uppercase">{s.interfaces.navBarEyebrow}</p>
          <h3 class="mt-1.5 font-serif text-xl font-medium text-ink">{s.interfaces.navBarTitle}</h3>
          <p class="mt-2 max-w-[56ch] text-sm/6 text-ink/65">{s.interfaces.navBarBody}</p>

          <div class="mt-5 grid grid-cols-3 gap-3 max-w-md">
            {s.interfaces.navBarKeys.map((k, idx) => (
              <div
                class:list={[
                  'rounded-lg border px-3 py-2.5 text-center',
                  idx === 1 ? 'border-ink/25 bg-ink/8' : 'border-ink/15 bg-surface',
                ]}
              >
                <div class="font-mono text-xs font-semibold text-ink">{k.key}</div>
                <div class="mt-0.5 text-[11px] text-ink/60">{k.label}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <img
            src="https://image.lceda.cn/oshwhub/pullImage/002fd6b3f22f4ec6892d22efe8b92397.png"
            alt={s.interfaces.navBarTitle}
            referrerpolicy="no-referrer"
            loading="lazy"
            class="max-h-44 w-auto object-contain"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. Engineering, Architecture & PCB Structure -->
<section id="engineering" class="scroll-mt-20 border-t border-ink/12 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.engineering.eyebrow}</p>
    <h2 class="mt-3 max-w-[26ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl" data-reveal style="--reveal-delay:80ms">
      {s.engineering.title}
    </h2>
    <p class="mt-4 max-w-[60ch] text-base/7 text-pretty text-ink/65" data-reveal style="--reveal-delay:140ms">
      {s.engineering.lede}
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {s.engineering.points.map((pt, i) => (
        <div
          class="rounded-xl border border-ink/12 bg-surface p-5"
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <div class="flex items-baseline gap-2.5">
            <span class="font-mono text-xs text-accent-600">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-lg font-medium text-ink">{pt.title}</h3>
          </div>
          <p class="mt-2 text-sm/6 text-ink/65">{pt.body}</p>
        </div>
      ))}
    </div>

    <figure class="mt-8 rounded-2xl border border-ink/12 bg-surface p-5 sm:p-6" data-reveal="art">
      <figcaption class="mb-3 font-mono text-[11px] tracking-widest text-ink/50 uppercase">
        {s.engineering.archLabel}
      </figcaption>
      <div class="overflow-hidden rounded-xl border border-ink/10 bg-white">
        <img
          src="https://image.lceda.cn/oshwhub/pullImage/2ea76046b3cc4a96aa7cd011b7d43a0e.png"
          alt={s.engineering.archAlt}
          referrerpolicy="no-referrer"
          loading="lazy"
          class="block h-auto w-full"
        />
      </div>
    </figure>

    <!-- PCB & Structure Craft -->
    <h3 class="mt-14 font-serif text-2xl font-medium text-ink" data-reveal>{s.engineering.structureTitle}</h3>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      <!-- 9.1 Mainboard -->
      <div class="rounded-2xl border border-ink/12 bg-surface p-5" data-reveal>
        <div class="grid grid-cols-2 gap-2.5">
          <div class="overflow-hidden rounded-xl border border-ink/10 bg-paper">
            <img
              src="https://image.lceda.cn/oshwhub/pullImage/bee42631250a428e9c6ba01fa3074def.png"
              alt="OnePage PCB Front"
              referrerpolicy="no-referrer"
              loading="lazy"
              class="block h-40 w-full object-cover"
            />
          </div>
          <div class="overflow-hidden rounded-xl border border-ink/10 bg-paper">
            <img
              src="https://image.lceda.cn/oshwhub/pullImage/95e0afefc94948d3b4271200b814b4b9.png"
              alt="OnePage PCB Back"
              referrerpolicy="no-referrer"
              loading="lazy"
              class="block h-40 w-full object-cover"
            />
          </div>
        </div>
        <h4 class="mt-4 font-serif text-lg font-medium text-ink">{s.engineering.pcb.title}</h4>
        <ul class="mt-2 space-y-1 text-sm/6 text-ink/65">
          {s.engineering.pcb.lines.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <!-- 9.2 Structural Stack -->
      <div class="rounded-2xl border border-ink/12 bg-surface p-5" data-reveal style="--reveal-delay:80ms">
        <div class="overflow-hidden rounded-xl border border-ink/10 bg-paper">
          <img
            src="https://image.lceda.cn/oshwhub/pullImage/0b9cfc3fb493495ca90a85d00bbfc60c.png"
            alt={s.engineering.stack.title}
            referrerpolicy="no-referrer"
            loading="lazy"
            class="block h-40 w-full object-cover"
          />
        </div>
        <h4 class="mt-4 font-serif text-lg font-medium text-ink">{s.engineering.stack.title}</h4>
        <ul class="mt-2 space-y-1 text-sm/6 text-ink/65">
          {s.engineering.stack.lines.map((line) => <li>{line}</li>)}
        </ul>
      </div>

      <!-- 9.3 Assembly -->
      <div class="rounded-2xl border border-ink/12 bg-surface p-5" data-reveal style="--reveal-delay:160ms">
        <div class="overflow-hidden rounded-xl border border-ink/10 bg-paper">
          <img
            src="https://image.lceda.cn/oshwhub/pullImage/ff4ce320d3f14ba685fed635793df61c.jpg"
            alt={s.engineering.assembly.title}
            referrerpolicy="no-referrer"
            loading="lazy"
            class="block h-40 w-full object-cover"
          />
        </div>
        <h4 class="mt-4 font-serif text-lg font-medium text-ink">{s.engineering.assembly.title}</h4>
        <ul class="mt-2 space-y-1 text-sm/6 text-ink/65">
          {s.engineering.assembly.lines.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>

    <!-- Key hardware notes -->
    <div class="mt-8 grid gap-4 md:grid-cols-3" data-reveal>
      <div class="rounded-xl border border-ink/12 bg-surface p-4">
        <div class="font-mono text-xs font-semibold text-ink">{s.engineering.notes.sdTitle}</div>
        <p class="mt-1.5 text-xs/5 text-ink/65">{s.engineering.notes.sdBody}</p>
      </div>
      <div class="rounded-xl border border-ink/12 bg-surface p-4">
        <div class="font-mono text-xs font-semibold text-ink">{s.engineering.notes.bootTitle}</div>
        <p class="mt-1.5 text-xs/5 text-ink/65">{s.engineering.notes.bootBody}</p>
      </div>
      <div class="rounded-xl border border-accent-300/60 bg-accent-50/60 p-4">
        <div class="font-mono text-xs font-semibold text-accent-700">⚠ {s.engineering.notes.screenTitle}</div>
        <p class="mt-1.5 text-xs/5 text-ink/70">{s.engineering.notes.screenBody}</p>
      </div>
    </div>
  </div>
</section>

<!-- 4. AI Experimental Easter Egg -->
<section id="ai" class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="rounded-2xl bg-ink p-7 text-paper shadow-sm sm:p-9" data-reveal>
      <p class="font-mono text-[11px] tracking-widest text-paper/60 uppercase">{s.ai.badge}</p>
      <h2 class="mt-2 font-serif text-2xl font-medium tracking-tight text-paper sm:text-3xl">{s.ai.title}</h2>
      <p class="mt-3 max-w-[68ch] text-sm/6 text-paper/75">{s.ai.body}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {s.ai.tags.map((tag) => (
          <span class="rounded-full border border-paper/15 bg-paper/10 px-3 py-1 font-mono text-[11px] text-paper/85">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {s.ai.cards.map((card, i) => (
        <div
          class="flex flex-col justify-between rounded-2xl border border-ink/12 bg-paper p-5"
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <div>
            <h3 class="font-serif text-lg font-medium text-ink">{card.title}</h3>
            <p class="mt-1.5 text-sm/6 text-ink/65">{card.body}</p>
          </div>
          <div class="mt-4 overflow-hidden rounded-xl border border-ink/10 bg-surface">
            <img
              src={card.img}
              alt={card.alt}
              referrerpolicy="no-referrer"
              loading="lazy"
              class="block h-auto w-full"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 5. Real-world Photos -->
<section id="photos" class="scroll-mt-20 border-t border-ink/12 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.photos.eyebrow}</p>
    <h2 class="mt-3 max-w-[24ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl" data-reveal style="--reveal-delay:80ms">
      {s.photos.title}
    </h2>
    <p class="mt-3 max-w-[56ch] text-base/7 text-ink/65" data-reveal style="--reveal-delay:140ms">
      {s.photos.lede}
    </p>

    <div class="mt-8 overflow-hidden rounded-2xl border border-ink/12 bg-surface shadow-sm" data-reveal="art">
      <img
        src={OVERVIEW_SHOT_URL}
        alt="OnePage overview"
        referrerpolicy="no-referrer"
        loading="lazy"
        class="block h-auto w-full object-cover"
      />
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {galleryImages.map((src, idx) => (
        <div
          class="overflow-hidden rounded-2xl border border-ink/12 bg-surface shadow-sm"
          data-reveal="art"
          style={`--reveal-delay:${idx * 60}ms`}
        >
          <img
            src={src}
            alt={`OnePage photo ${idx + 1}`}
            referrerpolicy="no-referrer"
            loading="lazy"
            class="block h-auto w-full object-cover"
          />
        </div>
      ))}
    </div>
  </div>
</section>
