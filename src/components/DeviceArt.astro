---
/**
 * Technical line-art illustrations of the OnePage device.
 * Placeholder visuals (engineering-sketch style) until real renders land.
 * Proportions traced from the docs/ renders. Strokes use non-scaling-stroke
 * so lines stay crisp at any size.
 */
interface Props {
  view: 'side' | 'front' | 'back' | 'bezel' | 'ports' | 'button';
  class?: string;
}
const { view, class: cls = '' } = Astro.props;
const S = 'vector-effect:non-scaling-stroke';
---

{view === 'side' && (
  <svg viewBox="0 0 1000 150" class:list={['w-full h-auto', cls]} role="img" fill="none">
    <ellipse cx="500" cy="112" rx="400" ry="7" class="fill-ink/5" />
    <!-- thin edge -->
    <rect x="60" y="60" width="880" height="26" rx="13" class="fill-[#fcfcfd] stroke-ink/40" stroke-width="1.5" style={S} />
    <line x1="74" y1="66" x2="926" y2="66" class="stroke-ink/15" stroke-width="1" style={S} />
    <line x1="62" y1="73" x2="938" y2="73" class="stroke-ink/10" stroke-width="1" style={S} />
    <!-- USB-C slot, centered -->
    <rect x="476" y="67" width="48" height="12" rx="6" class="fill-ink/75" style={S} />
    <!-- two side-key nubs protruding -->
    <rect x="300" y="86" width="40" height="7" rx="3.5" class="fill-ink/25" style={S} />
    <rect x="360" y="86" width="40" height="7" rx="3.5" class="fill-ink/25" style={S} />
  </svg>
)}

{view === 'front' && (
  <svg viewBox="0 0 480 660" class:list={['w-full h-auto', cls]} role="img" fill="none">
    <ellipse cx="240" cy="638" rx="172" ry="9" class="fill-ink/5" />
    <!-- frame -->
    <rect x="44" y="20" width="392" height="600" rx="34" class="fill-[#fcfcfd] stroke-ink/40" stroke-width="2" style={S} />
    <!-- aluminium mid-frame inner lip -->
    <rect x="50" y="26" width="380" height="588" rx="29" fill="none" class="stroke-ink/15" stroke-width="1" style={S} />
    <!-- e-ink screen -->
    <rect x="70" y="46" width="340" height="512" rx="10" class="fill-[#e3e5ea] stroke-ink/20" stroke-width="1.5" style={S} />
    <!-- faint reading lines -->
    <g class="stroke-ink/15" stroke-width="6" stroke-linecap="round" style={S}>
      <line x1="96" y1="92" x2="384" y2="92" />
      <line x1="96" y1="118" x2="384" y2="118" />
      <line x1="96" y1="144" x2="360" y2="144" />
      <line x1="96" y1="170" x2="384" y2="170" />
      <line x1="96" y1="196" x2="300" y2="196" />
    </g>
    <!-- 4 front keys on the chin -->
    <g class="fill-ink/15" style={S}>
      <rect x="108" y="588" width="46" height="12" rx="6" />
      <rect x="178" y="588" width="46" height="12" rx="6" />
      <rect x="248" y="588" width="46" height="12" rx="6" />
      <rect x="318" y="588" width="46" height="12" rx="6" />
    </g>
  </svg>
)}

{view === 'back' && (
  <svg viewBox="0 0 480 660" class:list={['w-full h-auto', cls]} role="img" fill="none">
    <ellipse cx="240" cy="638" rx="172" ry="9" class="fill-ink/5" />
    <!-- white acrylic back panel -->
    <rect x="44" y="20" width="392" height="600" rx="34" class="fill-[#fcfcfd] stroke-ink/40" stroke-width="2" style={S} />
    <!-- aluminium mid-frame edge -->
    <rect x="50" y="26" width="380" height="588" rx="29" fill="none" class="stroke-ink/18" stroke-width="1.5" style={S} />
    <!-- embossed mark -->
    <text x="240" y="372" text-anchor="middle" class="fill-ink/10" style="font-family:'Noto Serif SC','Noto Serif',serif;font-size:140px;font-weight:600">壹</text>
  </svg>
)}

{view === 'bezel' && (
  <svg viewBox="0 0 520 400" class:list={['w-full h-auto', cls]} role="img" fill="none">
    <!-- frame corner (extends past viewport) -->
    <rect x="44" y="44" width="600" height="500" rx="30" class="fill-[#fcfcfd] stroke-ink/40" stroke-width="2" style={S} />
    <!-- screen with a narrow bezel gap -->
    <rect x="70" y="70" width="560" height="460" rx="10" class="fill-[#e3e5ea] stroke-ink/20" stroke-width="1.5" style={S} />
    <!-- justified text lines -->
    <g class="stroke-ink/20" stroke-width="7" stroke-linecap="round" style={S}>
      <line x1="104" y1="128" x2="470" y2="128" />
      <line x1="104" y1="160" x2="470" y2="160" />
      <line x1="104" y1="192" x2="470" y2="192" />
      <line x1="104" y1="224" x2="438" y2="224" />
      <line x1="104" y1="256" x2="470" y2="256" />
      <line x1="104" y1="288" x2="300" y2="288" />
    </g>
  </svg>
)}

{view === 'ports' && (
  <svg viewBox="0 0 760 180" class:list={['w-full h-auto', cls]} role="img" fill="none">
    <rect x="20" y="46" width="720" height="96" rx="20" class="fill-[#fcfcfd] stroke-ink/40" stroke-width="2" style={S} />
    <!-- side-key nub -->
    <rect x="92" y="86" width="48" height="16" rx="8" class="fill-ink/20" style={S} />
    <!-- USB-C -->
    <rect x="196" y="84" width="68" height="20" rx="10" class="fill-ink/75" style={S} />
    <!-- microSD slot with little teeth -->
    <rect x="324" y="82" width="176" height="24" rx="4" class="fill-ink/80" style={S} />
    <g class="stroke-[#fcfcfd]" stroke-width="2.5" style={S}>
      <line x1="352" y1="88" x2="352" y2="100" />
      <line x1="372" y1="88" x2="372" y2="100" />
      <line x1="392" y1="88" x2="392" y2="100" />
      <line x1="412" y1="88" x2="412" y2="100" />
      <line x1="432" y1="88" x2="432" y2="100" />
      <line x1="452" y1="88" x2="452" y2="100" />
      <line x1="472" y1="88" x2="472" y2="100" />
    </g>
    <!-- mic hole -->
    <circle cx="612" cy="94" r="10" class="fill-ink/70" style={S} />
  </svg>
)}

{view === 'button' && (
  <svg viewBox="0 0 520 380" class:list={['w-full h-auto', cls]} role="img" fill="none">
    <!-- device corner (extends past right/bottom) -->
    <rect x="150" y="70" width="520" height="440" rx="44" class="fill-[#fcfcfd] stroke-ink/40" stroke-width="2" style={S} />
    <!-- inner screen edge -->
    <path d="M 196 116 H 640 M 196 116 V 460" class="stroke-ink/15" stroke-width="1.5" style={S} />
    <!-- chamfer highlight along the corner -->
    <path d="M 152 150 Q 152 96 206 92" class="stroke-accent-500/60" stroke-width="2" style={S} />
    <!-- two side-key nubs on the left edge -->
    <rect x="128" y="150" width="20" height="64" rx="9" class="fill-ink/20 stroke-ink/30" stroke-width="1" style={S} />
    <rect x="128" y="236" width="20" height="64" rx="9" class="fill-ink/20 stroke-ink/30" stroke-width="1" style={S} />
  </svg>
)}
