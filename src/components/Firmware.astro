---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = ui[lang].firmware;

// Manifest AND .bin are hosted SAME-ORIGIN under public/firmware/. GitHub release
// assets send no Access-Control-Allow-Origin, so a cross-origin browser fetch is
// blocked by CORS — same-origin sidesteps that. The manifest's part path is
// relative, resolved against the manifest URL at flash time.
const base = import.meta.env.BASE_URL;
const MANIFEST_URL = `${base}firmware/manifest.json`;

// Strings the client flasher needs at runtime.
const t = {
  manifestUrl: MANIFEST_URL,
  connecting: f.connecting,
  flashing: f.flashing,
  flashDone: f.flashDone,
  flashErr: f.flashErr,
  noSerial: f.noSerial,
};
---

<section class="py-12 sm:py-16" data-fw={JSON.stringify(t)}>
  <div class="mx-auto max-w-3xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase">{f.eyebrow}</p>
    <h1 class="mt-3 font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl">{f.title}</h1>
    <p class="mt-4 max-w-[60ch] text-base/7 text-pretty text-ink/70">{f.lede}</p>

    {/* ── Browser flash (Web Serial via esptool-js) ──────────────────────── */}
    <div class="mt-12 rounded-xl border border-ink/12 bg-surface p-6 sm:p-8">
      <h2 class="font-serif text-xl font-medium tracking-tight text-ink">{f.webTitle}</h2>
      <p class="mt-2 max-w-[56ch] text-sm/6 text-ink/65">{f.webLede}</p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button
          id="fwFlash"
          type="button"
          class="rounded-full bg-accent-600 px-5 py-2.5 font-mono text-sm font-medium text-paper transition hover:bg-accent-700 disabled:cursor-not-allowed disabled:opacity-50"
        >{f.connectBtn}</button>
      </div>

      {/* Progress + status (hidden until a flash starts) */}
      <div id="fwProgressWrap" class="mt-6 hidden">
        <div class="h-1.5 w-full overflow-hidden rounded-full bg-ink/10">
          <div id="fwProgressBar" class="h-full rounded-full bg-accent-500 transition-all duration-300" style="width:0%"></div>
        </div>
        <p id="fwProgressText" class="mt-2 font-mono text-xs text-ink/55"></p>
      </div>

      <p class="mt-4 font-mono text-xs text-ink/45">{f.browserNote}</p>
      <p id="fwUnsupported" class="mt-3 hidden max-w-[56ch] text-sm/6 text-accent-700">{f.unsupported}</p>
    </div>

    {/* ── Fallback: no-stub (slow) ───────────────────────────────────────── */}
    <div class="mt-8 rounded-xl border border-ink/12 p-6 sm:p-8">
      <h2 class="font-serif text-xl font-medium tracking-tight text-ink">{f.altTitle}</h2>
      <p class="mt-2 max-w-[56ch] text-sm/6 text-ink/65">{f.altLede}</p>
      <div class="mt-6">
        <button
          id="fwFlashNoStub"
          type="button"
          class="rounded-full border border-ink/20 px-5 py-2.5 font-mono text-sm font-medium text-ink/85 transition hover:border-ink/40 hover:text-ink disabled:cursor-not-allowed disabled:opacity-50"
        >{f.altBtn}</button>
      </div>
    </div>

    {/* ── Safety notes ───────────────────────────────────────────────────── */}
    <div class="mt-10">
      <h2 class="font-mono text-sm font-medium tracking-wider text-ink/80 uppercase">{f.notesTitle}</h2>
      <ul class="mt-4 space-y-3">
        {f.notes.map((n) => (
          <li class="flex gap-3 text-sm/6 text-ink/65">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-500" aria-hidden="true"></span>
            <span class="max-w-[62ch]">{n}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { flash, NoSerialError } from '../firmware/flash';

  const section = document.querySelector('[data-fw]');
  if (section) {
    const T = JSON.parse(section.getAttribute('data-fw') || '{}');
    const $ = (id: string) => document.getElementById(id);
    const btnStub = $('fwFlash') as HTMLButtonElement | null;
    const btnNoStub = $('fwFlashNoStub') as HTMLButtonElement | null;
    const wrap = $('fwProgressWrap');
    const bar = $('fwProgressBar');
    const text = $('fwProgressText');
    const unsupported = $('fwUnsupported');

    // No Web Serial → disable the buttons and show the notice up front.
    if (!('serial' in navigator)) {
      unsupported?.classList.remove('hidden');
      if (btnStub) btnStub.disabled = true;
      if (btnNoStub) btnNoStub.disabled = true;
    }

    const setStatus = (msg: string) => {
      if (text) text.textContent = msg;
    };
    const setProgress = (pct: number) => {
      if (bar) bar.style.width = pct + '%';
    };

    async function resolveBin(): Promise<{ url: string; offset: number }> {
      // Manifest is same-origin; its part path is relative to the manifest URL.
      const manifestUrl = new URL(T.manifestUrl, location.href);
      const manifest = await (await fetch(manifestUrl)).json();
      const part = manifest.builds[0].parts[0];
      return { url: new URL(part.path, manifestUrl).href, offset: part.offset };
    }

    async function run(noStub: boolean) {
      wrap?.classList.remove('hidden');
      setProgress(0);
      setStatus(T.connecting);
      if (btnStub) btnStub.disabled = true;
      if (btnNoStub) btnNoStub.disabled = true;
      try {
        const { url, offset } = await resolveBin();
        await flash({
          binUrl: url,
          offset,
          noStub,
          onProgress: (written, total) => {
            const pct = total ? Math.round((written / total) * 100) : 0;
            setProgress(pct);
            setStatus(`${T.flashing} ${pct}%`);
          },
          onLog: (msg) => setStatus(msg),
        });
        setProgress(100);
        setStatus('✓ ' + T.flashDone);
      } catch (err) {
        if (err instanceof NoSerialError) {
          setStatus(T.noSerial);
        } else if (err && (err as DOMException).name === 'NotFoundError') {
          // User dismissed the port picker — quietly reset.
          wrap?.classList.add('hidden');
        } else {
          setStatus(T.flashErr + ' (' + (err as Error).message + ')');
        }
      } finally {
        if (btnStub) btnStub.disabled = false;
        if (btnNoStub) btnNoStub.disabled = false;
      }
    }

    btnStub?.addEventListener('click', () => run(false));
    btnNoStub?.addEventListener('click', () => run(true));
  }
</script>
