---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Materials from './Materials.astro';
import Gallery from './Gallery.astro';
import Logbook from './Logbook.astro';
import Capabilities from './Capabilities.astro';
import BuildLog from './BuildLog.astro';
import Specs from './Specs.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fe = ui[lang].features;
---

<Nav lang={lang} />
<Hero lang={lang} />

<Materials lang={lang} />

<Gallery lang={lang} />

<!-- Reading spotlight + the rest as a capability grid -->
<section id="features" class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-5xl space-y-16 px-6">
    <Logbook lang={lang} {...fe.reading} view="bezel" id="reading" />
    <div class="rule-hair"></div>
    <Capabilities lang={lang} />
  </div>
</section>

<BuildLog lang={lang} />
<Specs lang={lang} />
<Footer lang={lang} />
