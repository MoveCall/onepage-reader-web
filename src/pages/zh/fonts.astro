---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import FontTool from '../../components/FontTool.astro';
import Footer from '../../components/Footer.astro';

const lang = 'zh';
---

<Layout
  lang={lang}
  title=".cpfont 字体生成器 — 壹頁 · OnePage"
  description="在浏览器本地把 TTF 或 OTF 字体转换成 OnePage 可直接读取的 CrossPoint .cpfont，全程不上传。"
>
  <Nav lang={lang} />
  <main>
    <FontTool lang={lang} />
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
